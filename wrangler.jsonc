{
  "name": "submergepsc-github-io",
  "compatibility_date": "2026-11-07",
  "build": {
    "command": "npm run build",
    "watch_dir": [
      "content",
      "scripts",
      "public/assets",
      "src/components",
      "src/composables",
      "src/pages",
      "src/styles",
      "src/tools",
      "src/main.js",
      "src/router.js",
      "src/App.vue",
      "src/data.js",
      "index.html",
      "vite.config.js"
    ]
  },
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
  },
}
